{
  "headers": [
    {
      "source": "/sigapro-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/profile-avatar-open",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/api/municipality-logo-open",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/storage-connection?action=health"
    },
    {
      "source": "/api/payment-connection",
      "destination": "/api/mercadopago?action=payment-connection"
    },
    {
      "source": "/api/mercadopago/health",
      "destination": "/api/mercadopago?action=health"
    },
    {
      "source": "/api/mercadopago/guide-boleto",
      "destination": "/api/mercadopago?action=guide-boleto"
    },
    {
      "source": "/api/mercadopago/guide-status",
      "destination": "/api/mercadopago?action=guide-status"
    },
    {
      "source": "/api/r2-upload",
      "destination": "/api/r2?action=upload"
    },
    {
      "source": "/api/r2-delete",
      "destination": "/api/r2?action=delete"
    },
    {
      "source": "/api/r2-sign-get",
      "destination": "/api/r2?action=sign-get"
    },
    {
      "source": "/api/r2-list-user-files",
      "destination": "/api/r2?action=list-user-files"
    },
    {
      "source": "/api/r2-master-logo-source",
      "destination": "/api/r2?action=master-logo-source"
    },
    {
      "source": "/api/profile-avatar-open",
      "destination": "/api/r2?action=profile-avatar-open"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "workbench-sigapro-polish-no-deploy-20261009": false,
      "fix/analise-premium-cadastro-20261013": false,
      "workbench/logo-preview-premium-no-deploy-20261016": false,
      "fix/vercel-serverless-esm-complete-no-deploy-20261020": false
    }
  }
}
